# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB — must be a replica set even locally, or transactions won't run (docker compose up -d)
MONGO_URI=mongodb://host.docker.internal:27017,host.docker.internal:27018,host.docker.internal:27019/yadah?replicaSet=rs0

# Auth (task 1.6)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# smsonlinegh (task 4.1 — key arrives after account setup, task 1.9)
SMS_API_KEY=
SMS_SENDER_ID=

# Resend (emails, incl. OTP). Empty = log-only, no emails sent.
RESEND_API_KEY=
EMAIL_FROM="Yadah <onboarding@resend.dev>"
