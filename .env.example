# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB — must be a replica set even locally, or transactions won't run (docker-compose, task 1.2)
MONGO_URI=mongodb://localhost:27017,localhost:27018,localhost:27019/yadah?replicaSet=rs0

# Auth (task 1.6)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# smsonlinegh (task 4.1 — key arrives after account setup, task 1.9)
SMS_API_KEY=
SMS_SENDER_ID=
