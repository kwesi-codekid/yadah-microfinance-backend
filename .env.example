# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB — must be a replica set even locally, or transactions won't run (docker compose up -d)
MONGO_URI=mongodb://host.docker.internal:27017,host.docker.internal:27018,host.docker.internal:27019/yadah?replicaSet=rs0

# Auth (task 1.6)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Seed admin — npx tsx src/scripts/seed.ts (idempotent; creates the first admin only).
# Unset = dev defaults. SEED_ADMIN_PASSWORD is REQUIRED when NODE_ENV=production.
# Leave commented to use the dev defaults — an empty value overrides them and breaks the seed.
#SEED_ADMIN_USERNAME=admin
#SEED_ADMIN_PHONE=0594213496
#SEED_ADMIN_EMAIL=admin@example.com
#SEED_ADMIN_PASSWORD=

# smsonlinegh (task 4.1 — key arrives after account setup, task 1.9)
SMS_API_KEY=
SMS_SENDER_ID=

# Resend (emails, incl. OTP). Empty = log-only, no emails sent.
RESEND_API_KEY=
EMAIL_FROM="Yadah <onboarding@resend.dev>"

# Cloudinary (customer photos). Empty = photo upload endpoint disabled.
CLOUDINARY_URL=

# Socket.io CORS — comma-separated origins, or * (default) until the frontend URL exists
FRONTEND_ORIGIN=*

# Data-population stage only. Lets the office date a susu or savings transaction
# to the day it actually happened, for history being typed in after the fact.
# Set the SAME value on the frontend. Turn it off once the branch is caught up —
# see src/lib/backdating.ts. Collectors are refused either way.
ALLOW_BACKDATED_ENTRY=false
